@model BObject.ComplaintMaster_CM
<style>
    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .pending-badge {
        background: #f8d7da;
        color: #b42318;
    }

    .assigned-badge {
        background: #fff3cd;
        color: #946200;
    }

    .progress-badge {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .resolved-badge {
        background: #d1fae5;
        color: #047857;
    }

    .rejected-badge {
        background: #f3f4f6;
        color: #4b5563;
    }
</style>
<table class="table table-bordered table-hover">

    <thead class="bg-primary">

        <tr>
            <th>Date & Time</th>
            <th>Status</th>
            <th>Assign To</th>
            <th>Remarks</th>
            <th>Updated By</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model.HistoryList)
        {
            <tr>

                <td>
                    @item.CH_UpdatedDate.ToString("dd-MMM-yyyy hh:mm tt")
                </td>

                <td>

                    @if (item.CH_Status == "Pending")
                    {
                        <span class="badge pending-badge">Pending</span>
                    }
                    else if (item.CH_Status == "Assigned")
                    {
                        <span class="badge assigned-badge">Assigned</span>
                    }
                    else if (item.CH_Status == "In Progress")
                    {
                        <span class="badge progress-badge">In Progress</span>
                    }
                    else if (item.CH_Status == "Resolved")
                    {
                        <span class="badge resolved-badge">
                            <i class="fa fa-check-circle"></i> Resolved

                            @if (item.CMPL_ResolvedDate.HasValue)
                            {
                                <br />
                                <small style="font-size:10px;">
                                    @item.CMPL_ResolvedDate.Value.ToString("dd-MMM-yyyy")
                                </small>
                            }
                        </span>
                    }
                    else
                    {
                        <span class="badge rejected-badge">Rejected</span>
                    }

                </td>

                <td>@item.CH_AssignTo</td>

                <td>@item.CH_Remarks</td>

                <td>@item.CH_UpdatedBy</td>

            </tr>
        }

    </tbody>

</table>